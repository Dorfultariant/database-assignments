@startuml GraphDatabase

'' src: https://pdf.plantuml.net/1.2020.22/PlantUML_Language_Reference_Guide_en.pdf 
''      Class Diagram
class CUSTOMER {
  CID
  NAME
  STREET
  CITY
  STATE
  COUNTRY
  PHONES
}
class ORDER {
  OID
  CID
  O_DATE
  O_TOTAL
}
class PRODUCT {
  PID
  P_NAME
  PRICE
}

CUSTOMER --> ORDER : placed
'' The ORDER - PRODUCT relation contains the ORDER_ITEM data (QTY), this is why ORDER_ITEM is not defined (relational related)
ORDER --> PRODUCT : contains(LINE_ID,QTY)

@enduml
